<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - <%= SITE_NAME %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @media (max-width: 768px) {
            .sidebar { transform: translateX(-100%); }
            .sidebar.open { transform: translateX(0); }
        }
        .btn-touch { min-height: 44px; }
        .modal {
            transition: opacity 0.3s ease;
            z-index: 100;
        }
        .modal.hidden {
            opacity: 0;
            pointer-events: none;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fadeIn {
            animation: fadeIn 0.3s ease-out;
        }
    </style>
</head>
<body class="bg-gray-50">
    <!-- Mobile Menu Button -->
    <button id="menuToggle" class="md:hidden fixed top-4 left-4 z-50 bg-[#F4C85B] text-black p-2 rounded-lg shadow-lg btn-touch">
        <i class="fas fa-bars"></i>
    </button>

    <!-- Sidebar -->
    <div id="sidebar" class="sidebar fixed inset-y-0 left-0 z-40 w-64 bg-gray-900 text-white transition-transform duration-300">
        <div class="p-4 border-b border-gray-700">
            <img src="/famslogo.png" alt="<%= SITE_NAME %>" class="h-8 mx-auto">
            <div class="text-center mt-3">
                <div class="font-semibold text-[#F4C85B] text-sm">Admin Panel</div>
                <div class="text-gray-400 text-xs"><%= admin.username %></div>
            </div>
        </div>
        
        <nav class="p-4 space-y-1">
            <a href="#dashboard" class="block py-2 px-3 bg-[#F4C85B] text-black rounded-lg text-sm font-medium">
                <i class="fas fa-chart-bar mr-2"></i>Dashboard
            </a>
            <a href="#products" class="block py-2 px-3 hover:bg-gray-800 rounded-lg text-sm transition-colors">
                <i class="fas fa-tshirt mr-2"></i>Products
            </a>
            <a href="#add-product" class="block py-2 px-3 hover:bg-gray-800 rounded-lg text-sm transition-colors">
                <i class="fas fa-plus mr-2"></i>Add Product
            </a>
            <a href="/admin/bulk-upload" class="block py-2 px-3 hover:bg-gray-800 rounded-lg text-sm transition-colors">
                <i class="fas fa-upload mr-2"></i>Advanced Bulk Upload
            </a>
            <a href="/admin/users" class="block py-2 px-3 hover:bg-gray-800 rounded-lg text-sm transition-colors">
                <i class="fas fa-users mr-2"></i>Manage Users
            </a>
            <a href="/admin/orders" class="block py-2 px-3 hover:bg-gray-800 rounded-lg text-sm transition-colors">
                <i class="fas fa-shopping-cart mr-2"></i>Manage Orders
            </a>
            <a href="/" target="_blank" class="block py-2 px-3 hover:bg-gray-800 rounded-lg text-sm transition-colors">
                <i class="fas fa-eye mr-2"></i>View Site
            </a>
            <a href="/admin/logout" class="block py-2 px-3 hover:bg-gray-800 rounded-lg text-sm transition-colors">
                <i class="fas fa-sign-out-alt mr-2"></i>Logout
            </a>
        </nav>
    </div>

    <!-- View Product Modal -->
    <div id="view-product-modal" class="modal hidden fixed inset-0 bg-black bg-opacity-70 flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-2xl max-w-4xl w-full max-h-[85vh] overflow-y-auto animate-fadeIn mx-4">
            <div id="view-product-content" class="p-4 md:p-6">
                <!-- Content loaded via JavaScript -->
            </div>
        </div>
    </div>

    <!-- Edit Product Modal -->
    <div id="edit-product-modal" class="modal hidden fixed inset-0 bg-black bg-opacity-70 flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-2xl max-w-4xl w-full max-h-[85vh] overflow-y-auto animate-fadeIn mx-4">
            <div class="p-4 md:p-6">
                <div class="flex justify-between items-center mb-4">
                    <h3 class="text-lg font-bold text-gray-900">Edit Product</h3>
                    <button onclick="closeEditModal()" class="text-gray-500 hover:text-gray-700">
                        <i class="fas fa-times text-xl"></i>
                    </button>
                </div>
                <form id="edit-product-form" method="POST" action="/admin/update-product" enctype="multipart/form-data">
                    <input type="hidden" name="product_id" id="edit_product_id">
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="space-y-3">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Product Name *</label>
                                <input type="text" name="name" id="edit_name" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
                            </div>
                            
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Description *</label>
                                <textarea name="description" id="edit_description" rows="3" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"></textarea>
                            </div>
                            
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Price (₦) *</label>
                                <input type="number" name="price" id="edit_price" step="0.01" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
                            </div>
                        </div>
                        
                        <div class="space-y-3">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Category *</label>
                                <select name="category" id="edit_category" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
                                    <option value="">Select Category</option>
                                    <option value="Dresses">Dresses</option>
                                    <option value="Gowns">Gowns</option>
                                    <option value="Kaftans">Kaftans</option>
                                    <option value="Corporate">Corporate</option>
                                    <option value="Traditional">Traditional</option>
                                </select>
                            </div>
                            
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Size Range</label>
                                <input type="text" name="size_range" id="edit_size_range" placeholder="S-XXL" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
                            </div>
                            
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Available Colors</label>
                                <input type="text" name="colors_available" id="edit_colors_available" placeholder="Red, Blue, Black" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
                            </div>
                            
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Product Image</label>
                                <input type="file" name="image" accept="image/*" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
                                <div id="current-image" class="mt-2 text-xs text-gray-500"></div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mt-4 space-y-3">
                        <div class="flex flex-col sm:flex-row sm:items-center gap-4">
                            <div class="flex items-center">
                                <input type="checkbox" name="is_featured" id="edit_is_featured" class="w-4 h-4 text-[#F4C85B] border-gray-300 rounded">
                                <label for="edit_is_featured" class="ml-2 text-sm text-gray-700">Feature this product</label>
                            </div>
                            
                            <div>
                                <label class="text-sm text-gray-700 mr-2">Stock:</label>
                                <select name="stock_status" id="edit_stock_status" class="px-2 py-1 border border-gray-300 rounded text-sm">
                                    <option value="in_stock">In Stock</option>
                                    <option value="low_stock">Low Stock</option>
                                    <option value="out_of_stock">Out of Stock</option>
                                </select>
                            </div>
                        </div>
                        
                        <div class="flex gap-2 pt-4">
                            <button type="submit" class="bg-[#F4C85B] hover:bg-amber-500 text-black font-semibold py-2 px-4 rounded-lg text-sm btn-touch">
                                <i class="fas fa-save mr-1"></i>Update Product
                            </button>
                            <button type="button" onclick="closeEditModal()" class="border border-gray-300 hover:bg-gray-50 text-gray-700 font-semibold py-2 px-4 rounded-lg text-sm btn-touch">
                                Cancel
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="md:ml-64 min-h-screen">
        <div class="p-4">
            <% if (message) { %>
            <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg mb-4 text-sm">
                <%= message %>
            </div>
            <% } %>

            <!-- Dashboard Stats -->
            <div id="dashboard" class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
                <div class="bg-white rounded-xl shadow-sm p-4">
                    <div class="flex items-center">
                        <div class="p-2 bg-amber-100 rounded-lg mr-3">
                            <i class="fas fa-tshirt text-[#F4C85B] text-sm"></i>
                        </div>
                        <div>
                            <div class="text-lg font-bold text-gray-900"><%= stats.total_products %></div>
                            <div class="text-gray-600 text-xs">Total Products</div>
                        </div>
                    </div>
                </div>
                
                <div class="bg-white rounded-xl shadow-sm p-4">
                    <div class="flex items-center">
                        <div class="p-2 bg-green-100 rounded-lg mr-3">
                            <i class="fas fa-star text-green-500 text-sm"></i>
                        </div>
                        <div>
                            <div class="text-lg font-bold text-gray-900"><%= stats.featured_products || 0 %></div>
                            <div class="text-gray-600 text-xs">Featured</div>
                        </div>
                    </div>
                </div>
                
                <div class="bg-white rounded-xl shadow-sm p-4">
                    <div class="flex items-center">
                        <div class="p-2 bg-blue-100 rounded-lg mr-3">
                            <i class="fas fa-crown text-blue-500 text-sm"></i>
                        </div>
                        <div>
                            <div class="text-lg font-bold text-gray-900"><%= stats.premium_products || 0 %></div>
                            <div class="text-gray-600 text-xs">Premium</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Add Product Form -->
            <div id="add-product" class="bg-white rounded-xl shadow-sm p-4 mb-6">
                <h2 class="text-lg font-bold mb-4 text-gray-900">Add New Product</h2>
                <form method="POST" action="/admin/add-product" enctype="multipart/form-data" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="space-y-3">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Product Name *</label>
                            <input type="text" name="name" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
                        </div>
                        
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Description *</label>
                            <textarea name="description" rows="2" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"></textarea>
                        </div>
                        
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Price (₦) *</label>
                            <input type="number" name="price" step="0.01" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
                        </div>
                    </div>
                    
                    <div class="space-y-3">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Category *</label>
                            <select name="category" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
                                <option value="">Select Category</option>
                                <option value="Dresses">Dresses</option>
                                <option value="Gowns">Gowns</option>
                                <option value="Kaftans">Kaftans</option>
                                <option value="Corporate">Corporate</option>
                                <option value="Traditional">Traditional</option>
                            </select>
                        </div>
                        
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Size Range</label>
                            <input type="text" name="size_range" placeholder="S-XXL" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
                        </div>
                        
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Available Colors</label>
                            <input type="text" name="colors_available" placeholder="Red, Blue, Black" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
                        </div>
                        
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Product Image</label>
                            <input type="file" name="image" accept="image/*" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
                        </div>
                    </div>
                    
                    <div class="md:col-span-2 space-y-3">
                        <div class="flex flex-col sm:flex-row sm:items-center gap-4">
                            <div class="flex items-center">
                                <input type="checkbox" name="is_featured" id="is_featured" class="w-4 h-4 text-[#F4C85B] border-gray-300 rounded">
                                <label for="is_featured" class="ml-2 text-sm text-gray-700">Feature this product</label>
                            </div>
                            
                            <div>
                                <label class="text-sm text-gray-700 mr-2">Stock:</label>
                                <select name="stock_status" class="px-2 py-1 border border-gray-300 rounded text-sm">
                                    <option value="in_stock">In Stock</option>
                                    <option value="low_stock">Low Stock</option>
                                    <option value="out_of_stock">Out of Stock</option>
                                </select>
                            </div>
                        </div>
                        
                        <div class="flex gap-2">
                            <button type="submit" class="bg-[#F4C85B] hover:bg-amber-500 text-black font-semibold py-2 px-4 rounded-lg text-sm btn-touch">
                                <i class="fas fa-plus mr-1"></i>Add Product
                            </button>
                            <button type="reset" class="border border-gray-300 hover:bg-gray-50 text-gray-700 font-semibold py-2 px-4 rounded-lg text-sm btn-touch">
                                Clear
                            </button>
                        </div>
                    </div>
                </form>
            </div>

            <!-- Bulk Upload Call to Action -->
            <div id="bulk-upload" class="bg-gradient-to-r from-[#F4C85B] to-amber-400 rounded-2xl shadow-md p-6 mb-8 text-black flex flex-col md:flex-row items-center justify-between gap-6">
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 bg-white bg-opacity-30 rounded-xl flex items-center justify-center text-xl">
                        <i class="fas fa-images"></i>
                    </div>
                    <div>
                        <h2 class="text-lg font-bold">New: Advanced Bulk Upload</h2>
                        <p class="text-sm opacity-90">Upload multiple images and edit details instantly in a grid view.</p>
                    </div>
                </div>
                <div class="flex gap-3 w-full md:w-auto">
                    <a href="/admin/bulk-upload" class="flex-1 md:flex-none text-center bg-black text-white font-bold py-3 px-8 rounded-xl hover:bg-gray-800 transition-all shadow-lg btn-touch text-sm">
                        Try It Now
                    </a>
                </div>
            </div>

            <!-- Bulk CSV Upload (Kept for compatibility) -->
            <div class="bg-white rounded-xl shadow-sm p-4 mb-6">
                <div class="flex items-center justify-between mb-4">
                    <h2 class="text-sm font-bold text-gray-900">Import from CSV</h2>
                    <button onclick="document.getElementById('csv-form').classList.toggle('hidden')" class="text-xs text-[#F4C85B] font-bold uppercase tracking-wider hover:underline">
                        Show Form
                    </button>
                </div>
                <form id="csv-form" method="POST" action="/admin/bulk-csv-upload" enctype="multipart/form-data" class="hidden">
                    <p class="text-xs text-gray-500 mb-4">Upload a CSV file with columns: <strong>name, description, price, category, image_path, size_range, colors_available, is_featured (0/1), stock_status</strong></p>
                    <div class="flex flex-col sm:flex-row gap-3">
                        <input type="file" name="csvFile" accept=".csv" required class="flex-1 px-3 py-2 border border-gray-300 rounded-lg text-sm">
                        <button type="submit" class="bg-gray-800 hover:bg-gray-900 text-white font-semibold py-2 px-4 rounded-lg text-sm btn-touch">
                            Import Data
                        </button>
                    </div>
                </form>
            </div>

            <!-- Products List -->
            <div id="products" class="bg-white rounded-xl shadow-sm p-4">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="text-lg font-bold text-gray-900">Product Management</h2>
                    <span class="bg-[#F4C85B] text-black px-2 py-1 rounded-full text-xs font-medium">
                        <%= products.length %> products
                    </span>
                </div>
                
                <% if (products.length === 0) { %>
                <div class="text-center py-8">
                    <i class="fas fa-tshirt text-3xl text-gray-300 mb-3"></i>
                    <p class="text-gray-500 text-sm">No products found.</p>
                </div>
                <% } else { %>
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="border-b border-gray-200">
                                <th class="text-left py-2 px-2 text-gray-700 font-medium">Product</th>
                                <th class="text-left py-2 px-2 text-gray-700 font-medium">Category</th>
                                <th class="text-left py-2 px-2 text-gray-700 font-medium">Price</th>
                                <th class="text-left py-2 px-2 text-gray-700 font-medium">Status</th>
                                <th class="text-left py-2 px-2 text-gray-700 font-medium">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% products.forEach(product => { %>
                            <tr class="border-b border-gray-100 hover:bg-gray-50">
                                <td class="py-2 px-2">
                                    <div class="flex items-center">
                                        <img src="/<%= product.image_path %>" 
                                             alt="<%= product.name %>"
                                             class="w-8 h-8 object-cover rounded mr-2"
                                             onerror="this.src='https://via.placeholder.com/100x100/f3f4f6/9ca3af?text=Image'">
                                        <div class="text-xs">
                                            <div class="font-medium text-gray-900"><%= product.name %></div>
                                            <% if (product.is_featured) { %>
                                            <span class="text-[#F4C85B] text-xs">Featured</span>
                                            <% } %>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-2 px-2 text-gray-600 text-xs"><%= product.category %></td>
                                <td class="py-2 px-2 font-semibold text-gray-900 text-xs">₦<%= product.price.toLocaleString() %></td>
                                <td class="py-2 px-2">
                                    <% 
                                    const status_badge = {
                                        'in_stock': ['bg-green-100 text-green-800', 'In Stock'],
                                        'low_stock': ['bg-yellow-100 text-yellow-800', 'Low Stock'],
                                        'out_of_stock': ['bg-red-100 text-red-800', 'Out of Stock']
                                    }[product.stock_status];
                                    %>
                                    <span class="inline-block <%= status_badge[0] %> text-xs px-2 py-1 rounded-full">
                                        <%= status_badge[1] %>
                                    </span>
                                </td>
                                <td class="py-2 px-2">
                                    <div class="flex gap-2">
                                        <!-- View Button -->
                                        <button data-id="<%= product.id %>" 
                                                class="view-product-btn text-blue-600 hover:text-blue-800 text-xs bg-blue-50 hover:bg-blue-100 px-2 py-1 rounded transition-colors">
                                            <i class="fas fa-eye mr-1"></i> View
                                        </button>
                                        
                                        <!-- Edit Button -->
                                        <button data-id="<%= product.id %>" 
                                                class="edit-product-btn text-green-600 hover:text-green-800 text-xs bg-green-50 hover:bg-green-100 px-2 py-1 rounded transition-colors">
                                            <i class="fas fa-edit mr-1"></i> Edit
                                        </button>
                                        
                                        <!-- Delete Button -->
                                        <form method="POST" action="/admin/delete-product" onsubmit="return confirm('Are you sure you want to delete this product?')" class="inline">
                                            <input type="hidden" name="product_id" value="<%= product.id %>">
                                            <button type="submit" 
                                                    class="text-red-600 hover:text-red-800 text-xs bg-red-50 hover:bg-red-100 px-2 py-1 rounded transition-colors">
                                                <i class="fas fa-trash mr-1"></i> Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
                <% } %>
            </div>
        </div>
    </div>

    <script>
        // Mobile menu toggle
        document.getElementById('menuToggle').addEventListener('click', function() {
            document.getElementById('sidebar').classList.toggle('open');
        });

        // Smooth scrolling for sidebar links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth' });
                    // Close mobile menu
                    document.getElementById('sidebar').classList.remove('open');
                }
            });
        });

        // View product function - loads HTML from /get-product
        function viewProduct(productId) {
            fetch('/get-product?id=' + productId)
                .then(response => {
                    if (!response.ok) throw new Error('Network error');
                    return response.text();
                })
                .then(html => {
                    const modal = document.getElementById('view-product-modal');
                    const content = document.getElementById('view-product-content');
                    
                    // Replace the close button functionality
                    const modifiedHtml = html.replace('closeProductModal()', 'closeViewModal()');
                    content.innerHTML = modifiedHtml;
                    
                    modal.classList.remove('hidden');
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Error loading product data');
                });
        }

        // Close view modal
        function closeViewModal() {
            document.getElementById('view-product-modal').classList.add('hidden');
        }

        // Edit product function - fetches product data and populates form
        function editProduct(productId) {
            // First get the product data from the products array (safely injected)
            const products = JSON.parse(document.getElementById('products-data').textContent);
            const product = products.find(p => p.id == productId);
            
            if (product) {
                // Populate the edit form
                document.getElementById('edit_product_id').value = product.id;
                document.getElementById('edit_name').value = product.name;
                document.getElementById('edit_description').value = product.description;
                document.getElementById('edit_price').value = product.price;
                document.getElementById('edit_category').value = product.category;
                document.getElementById('edit_size_range').value = product.size_range || '';
                document.getElementById('edit_colors_available').value = product.colors_available || '';
                document.getElementById('edit_is_featured').checked = product.is_featured == 1;
                document.getElementById('edit_stock_status').value = product.stock_status;
                
                // Show current image
                const currentImageDiv = document.getElementById('current-image');
                if (product.image_path) {
                    currentImageDiv.innerHTML = `Current: <img src="/${product.image_path}" class="h-16 w-16 object-cover rounded mt-1" onerror="this.style.display='none'">`;
                } else {
                    currentImageDiv.innerHTML = 'No image uploaded';
                }
                
                // Show modal
                document.getElementById('edit-product-modal').classList.remove('hidden');
            } else {
                alert('Product data not found');
            }
        }

        // Close edit modal
        function closeEditModal() {
            document.getElementById('edit-product-modal').classList.add('hidden');
        }

        // Close modals when clicking outside
        document.addEventListener('click', function(e) {
            const viewModal = document.getElementById('view-product-modal');
            const editModal = document.getElementById('edit-product-modal');
            
            if (e.target === viewModal) closeViewModal();
            if (e.target === editModal) closeEditModal();
        });

        // Close modals with Escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeViewModal();
                closeEditModal();
            }
        });

        // Auto-hide success message
        setTimeout(() => {
            const messageEl = document.querySelector('.bg-green-50');
            if (messageEl) messageEl.style.display = 'none';
        }, 5000);

        // Event listeners for product buttons
        document.addEventListener('click', function(e) {
            const viewBtn = e.target.closest('.view-product-btn');
            if (viewBtn) {
                viewProduct(viewBtn.dataset.id);
            }

            const editBtn = e.target.closest('.edit-product-btn');
            if (editBtn) {
                editProduct(editBtn.dataset.id);
            }
        });
    </script>
    <!-- Hidden data for JS -->
    <script id="products-data" type="application/json">
        <%- JSON.stringify(products) %>
    </script>
</body>
</html>
