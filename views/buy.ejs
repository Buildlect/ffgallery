<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <title>All Products - <%= SITE_NAME %></title>
  <meta name="description" content="Browse our complete collection of premium dresses, kaftans and fashion outfits.">

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    /* Preloader styles */
    #preloader {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-color: #ffffff;
      display: flex;
      justify-content: center;
      align-items: center;
      z-index: 9999;
      transition: opacity 0.5s ease-out;
    }
    
    #preloader.fade-out {
      opacity: 0;
      pointer-events: none;
    }
    
    .preloader-logo {
      animation: pulse 1s infinite;
    }
    
    @keyframes pulse {
      0% { transform: scale(1); opacity: 1; }
      50% { transform: scale(1.05); opacity: 0.8; }
      100% { transform: scale(1); opacity: 1; }
    }
    
    .modal {
      transition: opacity 0.3s ease;
      z-index: 100;
    }
    
    .modal.hidden {
      opacity: 0;
      pointer-events: none;
    }
    
    #whatsapp-confirm-modal {
      z-index: 200;
    }
    
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    
    .animate-fadeIn {
      animation: fadeIn 0.3s ease-out;
    }
    
    .hover-lift {
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    
    .hover-lift:hover {
      transform: translateY(-2px);
    }
    
    .btn-touch {
      min-height: 44px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    
    .img-fit {
      object-fit: cover;
      width: 100%;
      height: 100%;
    }
  </style>
</head>

<body class="bg-white text-gray-900 overflow-x-hidden" data-is-logged-in="<%= user ? 'true' : 'false' %>">
  <!-- Preloader -->
  <div id="preloader">
    <img src="/famslogo.png" alt="<%= SITE_NAME %> logo" class="h-16 md:h-20 w-auto preloader-logo" />
  </div>

  <!-- WhatsApp Confirmation Modal -->
  <div id="whatsapp-confirm-modal" class="modal hidden fixed inset-0 bg-black bg-opacity-70 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-sm w-full p-6 animate-fadeIn shadow-2xl mx-4">
      <div class="text-center mb-6">
        <div class="w-14 h-14 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
          <i class="fab fa-whatsapp text-green-600 text-xl"></i>
        </div>
        <h3 class="text-lg font-bold text-gray-900 mb-2">Continue to WhatsApp?</h3>
        <p class="text-gray-600 text-sm" id="whatsapp-modal-text">You'll be redirected to WhatsApp to chat with us.</p>
      </div>
      <div class="flex flex-col gap-2">
        <button id="confirm-whatsapp" class="w-full bg-green-600 hover:bg-green-700 text-white font-semibold py-3 px-4 rounded-lg transition-colors btn-touch text-sm">
          <i class="fab fa-whatsapp mr-2"></i>
          Open WhatsApp
        </button>
        <button id="cancel-whatsapp" class="w-full border border-gray-300 hover:bg-gray-50 text-gray-700 font-semibold py-3 px-4 rounded-lg transition-colors btn-touch text-sm">
          Cancel
        </button>
      </div>
    </div>
  </div>

  <!-- Product Detail Modal -->
  <div id="product-modal" class="modal hidden fixed inset-0 bg-black bg-opacity-70 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-4xl w-full max-h-[85vh] overflow-y-auto animate-fadeIn mx-4">
      <div id="product-modal-content" class="p-4 md:p-6">
        <!-- Content loaded via JavaScript -->
      </div>
    </div>
  </div>

  <!-- Header -->
  <header class="fixed top-0 w-full bg-white shadow-sm z-40 border-b">
    <div class="max-w-7xl mx-auto px-4 py-3 flex justify-between items-center">
      <div class="flex items-center gap-2">
        <a href="/">
          <img src="/famslogo.png" alt="<%= SITE_NAME %> logo" class="h-8 md:h-10 w-auto" />
        </a>
        <a href="/" class="text-base md:text-lg font-bold text-gray-900">Fam's Fashion</a>
      </div>

      <nav class="hidden md:flex gap-6 text-sm font-medium">
        <a href="/" class="text-gray-800 hover:text-[#F4C85B] transition-colors duration-200">Home</a>
        <a href="/buy" class="text-gray-800 hover:text-[#F4C85B] transition-colors duration-200 font-bold">All Products</a>
        <a href="/#about" class="text-gray-800 hover:text-[#F4C85B] transition-colors duration-200">About</a>
        <a href="/#contact" class="text-gray-800 hover:text-[#F4C85B] transition-colors duration-200">Contact</a>
      </nav>

      <div class="flex items-center gap-2">
        <% if (user) { %>
          <a href="/dashboard" class="hidden md:flex items-center gap-2 px-3 py-2 rounded-lg hover:bg-gray-50 transition-colors">
            <div class="w-8 h-8 bg-amber-100 text-amber-600 rounded-full flex items-center justify-center text-xs font-bold uppercase">
              <%= user.full_name.charAt(0) %>
            </div>
            <span class="text-sm font-medium text-gray-700">My Account</span>
          </a>
        <% } else { %>
          <a href="/login" class="hidden md:flex items-center px-3 py-2 text-sm font-bold text-gray-700 hover:text-[#F4C85B] transition-colors">Login</a>
          <a href="/register" class="hidden md:flex items-center px-4 py-2 text-sm font-bold bg-gray-900 text-white rounded-lg hover:bg-gray-800 transition-all">Register</a>
        <% } %>

        <button onclick="openWhatsAppModal('<%= WHATSAPP_CHAT_URL %>', 'chat')" 
           class="hidden sm:flex items-center px-3 py-2 rounded-lg bg-[#F4C85B] hover:bg-amber-500 text-black font-medium transition-colors duration-200 btn-touch text-sm">
          <i class="fab fa-whatsapp mr-1"></i>
          <span class="hidden md:inline">Chat</span>
        </button>
        
        <!-- Mobile menu button -->
        <button id="mobile-menu-button" class="md:hidden text-gray-800 p-2 rounded-lg hover:bg-gray-100 btn-touch" aria-label="Toggle mobile menu">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>
    
    <!-- Mobile Menu -->
    <div id="mobile-menu" class="md:hidden hidden bg-white px-4 pb-4 shadow-lg border-t">
      <div class="flex flex-col space-y-3">
        <a href="/" class="text-gray-800 hover:text-[#F4C85B] transition-colors py-3 border-b border-gray-100 text-sm font-bold">Home</a>
        <a href="/buy" class="text-gray-800 hover:text-[#F4C85B] transition-colors py-3 border-b border-gray-100 text-sm font-bold">All Products</a>
        <a href="/#about" class="text-gray-800 hover:text-[#F4C85B] transition-colors py-3 border-b border-gray-100 text-sm">About</a>
        <a href="/#contact" class="text-gray-800 hover:text-[#F4C85B] transition-colors py-3 border-b border-gray-100 text-sm">Contact</a>
        
        <% if (user) { %>
          <a href="/dashboard" class="text-gray-800 hover:text-[#F4C85B] transition-colors py-3 border-b border-gray-100 text-sm font-bold">My Account</a>
          <a href="/logout" class="text-red-500 py-3 border-b border-gray-100 text-sm font-bold">Logout</a>
        <% } else { %>
          <a href="/login" class="text-gray-800 hover:text-[#F4C85B] transition-colors py-3 border-b border-gray-100 text-sm font-bold">Login</a>
          <a href="/register" class="text-gray-800 hover:text-[#F4C85B] transition-colors py-3 border-b border-gray-100 text-sm font-bold">Register</a>
        <% } %>

        <button onclick="openWhatsAppModal('<%= WHATSAPP_CHAT_URL %>', 'chat')" 
           class="flex items-center justify-center px-4 py-3 rounded-lg bg-[#F4C85B] hover:bg-amber-500 text-black font-medium transition-colors btn-touch text-sm">
          <i class="fab fa-whatsapp mr-2"></i>
          Chat on WhatsApp
        </button>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="pt-24 pb-12">
    <div class="max-w-6xl mx-auto px-4">
      <!-- Page Header -->
      <div class="text-center mb-8">
        <h1 class="text-2xl md:text-4xl font-bold mb-2 text-gray-900">All Products</h1>
        <p class="text-gray-600 text-sm md:text-base">Browse our complete collection of premium fashion</p>
      </div>

      <!-- Search and Filter -->
      <div class="bg-white rounded-xl shadow-sm p-4 mb-6">
        <form method="GET" class="flex flex-col sm:flex-row gap-3">
          <div class="flex-1">
            <input type="text" name="search" value="<%= search %>" 
                   placeholder="Search products..." 
                   class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#F4C85B] focus:border-[#F4C85B] text-sm">
          </div>
          <select name="category" class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#F4C85B] focus:border-[#F4C85B] text-sm">
            <option value="">All Categories</option>
            <% categories.forEach(cat => { %>
            <option value="<%= cat %>" <%= categoryFilter === cat ? 'selected' : '' %>>
              <%= cat %>
            </option>
            <% }); %>
          </select>
          <button type="submit" class="px-4 py-2 bg-[#F4C85B] hover:bg-amber-500 text-black rounded-lg font-medium transition-colors btn-touch text-sm">
            <i class="fas fa-search mr-1"></i> Search
          </button>
          <% if (search || categoryFilter) { %>
          <a href="/buy" class="px-4 py-2 border border-gray-300 hover:bg-gray-50 text-gray-700 rounded-lg font-medium transition-colors btn-touch text-sm">
            Clear
          </a>
          <% } %>
        </form>
      </div>

      <!-- Results Count -->
      <div class="flex justify-between items-center mb-4">
        <p class="text-gray-600 text-sm">
          Showing <%= allProducts.length %> products
          <% if (search) { %>
            for "<%= search %>"
          <% } %>
          <% if (categoryFilter) { %>
            in <%= categoryFilter %>
          <% } %>
        </p>
      </div>

      <!-- Products Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        <% if (allProducts && allProducts.length > 0) { %>
          <% allProducts.forEach(product => { %>
          <div class="bg-white rounded-xl shadow-sm hover:shadow-md transition-all duration-200 overflow-hidden hover-lift border">
            <div class="relative overflow-hidden aspect-[3/4] group">
              <img src="/<%= product.image_path %>" 
                   alt="<%= product.name %>"
                   class="img-fit group-hover:scale-105 transition-transform duration-300"
                   onerror="this.src='https://via.placeholder.com/300x400/f3f4f6/9ca3af?text=Product+Image'">
              <div class="absolute top-2 right-2 flex flex-col gap-2">
                <div class="bg-[#F4C85B] text-black px-2 py-1 rounded-full text-xs font-bold shadow-sm">
                  ₦<%= product.price.toLocaleString() %>
                </div>
                <button data-id="<%= product.id %>" 
                        class="btn-toggle-favorite bg-white text-gray-400 hover:text-red-500 w-8 h-8 rounded-full flex items-center justify-center shadow-md transition-all active:scale-90">
                  <i class="fas fa-heart"></i>
                </button>
              </div>
              <% if (product.is_featured) { %>
              <div class="absolute top-2 left-2 bg-red-500 text-white px-2 py-1 rounded-full text-xs font-bold">
                Featured
              </div>
              <% } %>
            </div>
            <div class="p-3">
              <h3 class="font-semibold text-gray-900 mb-1 text-sm leading-tight"><%= product.name %></h3>
              <p class="text-gray-500 text-xs mb-1"><%= product.category %></p>
              <p class="text-gray-600 text-xs mb-3 line-clamp-2"><%= product.description %></p>
              <div class="flex gap-1">
                <button data-id="<%= product.id %>" 
                        class="btn-view-product flex-1 px-2 py-2 bg-[#F4C85B] hover:bg-amber-500 text-black rounded-lg font-medium transition-colors flex items-center justify-center btn-touch text-xs">
                  <i class="fas fa-eye mr-1"></i>
                  View
                </button>
                <button data-url="<%= WHATSAPP_CHAT_URL %>?text=Hi! I'm interested in <%= encodeURIComponent(product.name) %> (₦<%= product.price.toLocaleString() %>)" 
                        data-type="product"
                        class="btn-buy-product flex-1 px-2 py-2 bg-gray-800 hover:bg-gray-900 text-white rounded-lg font-medium transition-colors flex items-center justify-center btn-touch text-xs">
                  <i class="fab fa-whatsapp mr-1"></i>
                  Buy
                </button>
              </div>
            </div>
          </div>
          <% }); %>
        <% } else { %>
          <div class="col-span-4 text-center py-12">
            <i class="fas fa-search text-3xl text-gray-300 mb-3"></i>
            <p class="text-gray-500 text-sm mb-2">No products found.</p>
            <% if (search || categoryFilter) { %>
            <a href="/buy" class="text-[#F4C85B] hover:text-amber-500 text-sm font-medium">Clear filters</a>
            <% } %>
          </div>
        <% } %>
      </div>
    </div>
  </main>

  <!-- Footer -->
  <footer class="bg-gray-900 text-gray-300 py-8">
    <div class="max-w-6xl mx-auto px-4 text-center">
      <div class="mb-4">
        <h3 class="text-white font-bold text-lg mb-2"><%= SITE_NAME %></h3>
        <p class="text-sm text-gray-400">Premium Fashion Gallery</p>
      </div>
      <p class="text-xs mb-4">
        WhatsApp: <a href="#" onclick="openWhatsAppModal('<%= WHATSAPP_CHAT_URL %>', 'chat')" class="text-[#F4C85B] underline">+<%= WHATSAPP_NUMBER %></a>
      </p>
      <p class="text-xs">
        <a href="https://buildlect.com" target="_blank" rel="noopener" class="text-[#F4C85B] underline">Powered by Buildlect Technologies</a>
      </p>
    </div>
  </footer>

  <!-- Admin Access -->
  <a href="/admin" class="fixed bottom-4 right-4 z-30 bg-[#F4C85B] hover:bg-amber-500 text-black p-3 rounded-full shadow-lg hover-lift transition-all duration-200 opacity-40 hover:opacity-100 btn-touch">
    <i class="fas fa-cog text-sm"></i>
  </a>

  <script>
    const IS_LOGGED_IN = document.body.dataset.isLoggedIn === 'true';
    
    // Enhanced preloader with 1.5-second duration
    function hidePreloader() {
      const preloader = document.getElementById('preloader');
      if (preloader) {
        preloader.classList.add('fade-out');
        setTimeout(() => {
          preloader.style.display = 'none';
        }, 500);
      }
    }

    // Hide preloader when page loads (1.5 seconds)
    window.addEventListener('load', function() {
      setTimeout(hidePreloader, 1500);
    });

    // Fallback: hide preloader after 3 seconds
    setTimeout(hidePreloader, 3000);

    // Mobile menu functionality
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    
    if (mobileMenuButton && mobileMenu) {
      mobileMenuButton.addEventListener('click', function() {
        mobileMenu.classList.toggle('hidden');
      });
    }

    // Modal functionality
    const productModal = document.getElementById('product-modal');
    const whatsappModal = document.getElementById('whatsapp-confirm-modal');
    let currentWhatsAppUrl = '';

    function openProductModal(productId) {
      fetch(`/get-product?id=${productId}`)
        .then(response => {
          if (!response.ok) throw new Error('Network error');
          return response.text();
        })
        .then(html => {
          if (productModal) {
            document.getElementById('product-modal-content').innerHTML = html;
            productModal.classList.remove('hidden');
          }
        })
        .catch(error => {
          console.error('Error:', error);
          openWhatsAppModal('<%= WHATSAPP_CHAT_URL %>?text=Hi! I\'m interested in product ID ' + productId, 'product');
        });
    }

    function closeProductModal() {
      if (productModal) {
        productModal.classList.add('hidden');
      }
    }

    function openWhatsAppModal(url, type = 'chat') {
      currentWhatsAppUrl = url;
      const modalText = document.getElementById('whatsapp-modal-text');
      
      if (modalText) {
        if (type === 'product') {
          modalText.textContent = 'You\'ll be redirected to WhatsApp to inquire about this product.';
        } else {
          modalText.textContent = 'You\'ll be redirected to WhatsApp to chat with us.';
        }
      }
      
      if (whatsappModal) {
        whatsappModal.classList.remove('hidden');
      }
    }

    function closeWhatsAppModal() {
      if (whatsappModal) {
        whatsappModal.classList.add('hidden');
      }
    }

    function confirmWhatsApp() {
      if (currentWhatsAppUrl) {
        window.open(currentWhatsAppUrl, '_blank');
      }
      closeWhatsAppModal();
    }

    // Event listeners
    document.addEventListener('DOMContentLoaded', function() {
      // WhatsApp modal events
      const confirmWhatsAppBtn = document.getElementById('confirm-whatsapp');
      const cancelWhatsAppBtn = document.getElementById('cancel-whatsapp');
      
      if (confirmWhatsAppBtn) confirmWhatsAppBtn.addEventListener('click', confirmWhatsApp);
      if (cancelWhatsAppBtn) cancelWhatsAppBtn.addEventListener('click', closeWhatsAppModal);
    });

    // Close modals when clicking outside
    document.addEventListener('click', function(e) {
      if (productModal && e.target === productModal) closeProductModal();
      if (whatsappModal && e.target === whatsappModal) closeWhatsAppModal();
    });

    // Close modal with Escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        if (productModal && !productModal.classList.contains('hidden')) closeProductModal();
        if (whatsappModal && !whatsappModal.classList.contains('hidden')) closeWhatsAppModal();
      }
    });

    // Add focus styles for accessibility
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Tab') {
        document.body.classList.add('using-keyboard');
      }
    });
    
    document.addEventListener('mousedown', function() {
      document.body.classList.remove('using-keyboard');
    });

    // Event listeners for product buttons
    document.addEventListener('click', function(e) {
      // View product
      const viewBtn = e.target.closest('.btn-view-product');
      if (viewBtn) {
        openProductModal(viewBtn.dataset.id);
      }

      // Buy product (WhatsApp)
      const buyBtn = e.target.closest('.btn-buy-product');
      if (buyBtn) {
        openWhatsAppModal(buyBtn.dataset.url, buyBtn.dataset.type);
      }

      // Generic WhatsApp links
      const waBtn = e.target.closest('[onclick^="openWhatsAppModal"]');
      if (waBtn && !waBtn.classList.contains('btn-buy-product')) {
        // Fallback for remaining inline handlers if any
      }
    });

    // Handle header chat button and footer links
    document.querySelectorAll('[onclick*="openWhatsAppModal"]').forEach(el => {
      const attr = el.getAttribute('onclick');
      if (attr) {
        const match = attr.match(/openWhatsAppModal\('(.*?)', '(.*?)'\)/);
        if (match) {
          el.removeAttribute('onclick');
          el.addEventListener('click', (e) => {
            e.preventDefault();
            openWhatsAppModal(match[1], match[2]);
          });
        }
      }
    });

    async function toggleFavorite(productId, btn) {
      if (!IS_LOGGED_IN) {
        window.location.href = '/login?message=' + encodeURIComponent('Login to save favorites!');
        return;
      }
      
      const icon = btn.querySelector('i');
      try {
        const response = await fetch('/api/favorites/toggle', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ product_id: productId })
        });
        const result = await response.json();
        if (result.success) {
          if (result.action === 'added') {
            icon.classList.remove('far');
            icon.classList.add('fas', 'text-red-500');
            btn.classList.add('text-red-500');
          } else {
            icon.classList.remove('fas', 'text-red-500');
            icon.classList.add('fas');
            btn.classList.remove('text-red-500');
            btn.classList.add('text-gray-400');
          }
        }
      } catch (error) {
        console.error('Error:', error);
      }
    }

    // Add listener for favorite buttons
    document.addEventListener('click', function(e) {
      const favBtn = e.target.closest('.btn-toggle-favorite');
      if (favBtn) {
        toggleFavorite(favBtn.dataset.id, favBtn);
      }
    });
  </script>
</body>
</html>
