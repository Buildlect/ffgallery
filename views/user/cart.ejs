<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Cart - <%= SITE_NAME %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .hover-lift:hover { transform: translateY(-2px); }
        .btn-touch { min-height: 44px; min-width: 44px; }
    </style>
</head>
<body class="bg-gray-50 text-gray-900">
    <header class="bg-white shadow-sm border-b sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 py-3 flex justify-between items-center">
            <a href="/" class="flex items-center gap-2">
                <img src="/famslogo.png" alt="Logo" class="h-8 w-auto">
                <span class="font-bold text-lg">My Cart</span>
            </a>
            <a href="/buy" class="text-sm font-medium text-gray-600 hover:text-[#F4C85B]">
                <i class="fas fa-arrow-left mr-1"></i> Continue Shopping
            </a>
        </div>
    </header>

    <main class="max-w-4xl mx-auto px-4 py-8">
        <h1 class="text-2xl font-bold mb-6">Shopping Cart</h1>

        <% if (cartProducts.length > 0) { %>
            <div class="bg-white rounded-2xl shadow-sm border overflow-hidden mb-6">
                <div class="divide-y">
                    <% cartProducts.forEach(item => { %>
                        <div class="p-4 flex gap-4 items-center">
                            <img src="/<%= item.image_path %>" alt="<%= item.name %>" class="w-20 h-24 object-cover rounded-lg border">
                            <div class="flex-1">
                                <h3 class="font-bold text-gray-900 text-sm md:text-base"><%= item.name %></h3>
                                <p class="text-gray-500 text-xs mb-2"><%= item.category %></p>
                                <div class="flex justify-between items-center">
                                    <span class="font-bold text-amber-600 text-sm">₦<%= item.price.toLocaleString() %></span>
                                    <span class="text-gray-600 text-sm">Qty: <%= item.quantity %></span>
                                </div>
                            </div>
                            <form action="/cart/remove" method="POST">
                                <input type="hidden" name="product_id" value="<%= item.id %>">
                                <button type="submit" class="text-red-400 hover:text-red-600 p-2 btn-touch">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </form>
                        </div>
                    <% }); %>
                </div>
            </div>

            <div class="bg-white rounded-2xl shadow-sm border p-6">
                <div class="flex justify-between items-center mb-6">
                    <span class="text-gray-600 font-medium text-lg">Total Amount</span>
                    <span class="text-2xl font-bold text-gray-900">₦<%= total.toLocaleString() %></span>
                </div>
                <a href="/checkout" class="block w-full bg-gray-900 text-white text-center py-4 rounded-xl font-bold hover:bg-gray-800 transition-all shadow-lg">
                    Proceed to Checkout
                </a>
            </div>
        <% } else { %>
            <div class="text-center py-16 bg-white rounded-2xl shadow-sm border">
                <div class="w-20 h-20 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                    <i class="fas fa-shopping-basket text-gray-400 text-3xl"></i>
                </div>
                <p class="text-gray-500 mb-6">Your cart is empty.</p>
                <a href="/buy" class="inline-block bg-[#F4C85B] text-black px-8 py-3 rounded-lg font-bold hover:bg-amber-500 transition-all">
                    Start Shopping
                </a>
            </div>
        <% } %>
    </main>
</body>
</html>
