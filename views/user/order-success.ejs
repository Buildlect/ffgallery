<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Success - <%= SITE_NAME %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-50 flex items-center justify-center min-h-screen p-4">
    <div class="bg-white rounded-3xl p-8 md:p-12 shadow-2xl max-w-md w-full text-center">
        <div class="w-20 h-20 bg-green-100 text-green-600 rounded-full flex items-center justify-center mx-auto mb-6">
            <i class="fas fa-check text-3xl"></i>
        </div>
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Order Placed!</h1>
        <p class="text-gray-500 mb-6">Thank you for your purchase. Your order ID is <span class="font-bold text-gray-900">#<%= orderId %></span>.</p>
        
        <div class="bg-amber-50 rounded-2xl p-6 mb-8 text-left">
            <h3 class="font-bold text-amber-800 mb-2 flex items-center gap-2">
                <i class="fab fa-whatsapp"></i> What's next?
            </h3>
            <p class="text-sm text-amber-700 leading-relaxed">
                Please click the button below to send your order confirmation to our WhatsApp. This ensures faster processing!
            </p>
        </div>

        <div class="flex flex-col gap-3">
            <a href="https://wa.me/<%= WHATSAPP_NUMBER %>?text=Hi! I just placed an order #<%= orderId %> on your website." target="_blank" class="bg-green-600 text-white font-bold py-4 rounded-2xl hover:bg-green-700 transition-all flex items-center justify-center gap-2">
                <i class="fab fa-whatsapp"></i> Confirm on WhatsApp
            </a>
            <a href="/dashboard" class="text-gray-500 font-bold py-4 rounded-2xl hover:bg-gray-100 transition-all">
                Go to My Dashboard
            </a>
        </div>
    </div>
</body>
</html>
