<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <title><%= SITE_NAME %> | Premium Dresses, Kaftans & Fashion Outfits</title>
  <meta name="title" content="<%= SITE_NAME %> | Premium Dresses, Kaftans & Fashion Outfits">
  <meta name="description" content="Discover premium dresses, kaftans and classy outfits tailored to perfection. Elegant fashion with perfect finishing. WhatsApp: +<%= WHATSAPP_NUMBER %>">
  <meta name="keywords" content="fashion, dresses, kaftans, outfits, premium clothing, Nigerian fashion, ladies wear, elegant gowns, luxury fashion, <%= SITE_NAME %>">
  <meta name="author" content="<%= SITE_NAME %>">
  <meta name="robots" content="index, follow">
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= SITE_URL %>/">
  <meta property="og:title" content="<%= SITE_NAME %> | Premium Dresses, Kaftans & Fashion Outfits">
  <meta property="og:description" content="Discover premium dresses, kaftans and classy outfits tailored to perfection. Elegant fashion with perfect finishing.">
  <meta property="og:image" content="<%= SITE_URL %>/famslogo.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:site_name" content="<%= SITE_NAME %>">

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image">
  <meta property="twitter:url" content="<%= SITE_URL %>/">
  <meta property="twitter:title" content="<%= SITE_NAME %> | Premium Dresses, Kaftans & Fashion Outfits">
  <meta property="twitter:description" content="Discover premium dresses, kaftans and classy outfits tailored to perfection. Elegant fashion with perfect finishing.">
  <meta property="twitter:image" content="<%= SITE_URL %>/famslogo.png">

  <!-- Canonical URL -->
  <link rel="canonical" href="<%= SITE_URL %>/">

  <!-- Favicon -->
  <link rel="icon" href="/famslogo.png" type="image/png">
  <link rel="apple-touch-icon" href="/famslogo.png">

  <!-- Structured Data -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FashionBrand",
    "name": "<%= SITE_NAME %>",
    "description": "Premium dresses, kaftans and classy outfits tailored to perfection",
    "url": "<%= SITE_URL %>",
    "logo": "<%= SITE_URL %>/famslogo.png",
    "telephone": "+<%= WHATSAPP_NUMBER %>",
    "address": {
      "@type": "PostalAddress",
      "addressCountry": "NG"
    },
    "sameAs": [
      "<%= WHATSAPP_CHAT_URL %>"
    ]
  }
  </script>

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    /* Preloader styles */
    #preloader {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-color: #ffffff;
      display: flex;
      justify-content: center;
      align-items: center;
      z-index: 9999;
      transition: opacity 0.5s ease-out;
    }
    
    #preloader.fade-out {
      opacity: 0;
      pointer-events: none;
    }
    
    .preloader-logo {
      animation: pulse 1s infinite;
    }
    
    @keyframes pulse {
      0% { transform: scale(1); opacity: 1; }
      50% { transform: scale(1.05); opacity: 0.8; }
      100% { transform: scale(1); opacity: 1; }
    }
    
    /* Smooth scrolling */
    html {
      scroll-behavior: smooth;
    }
    
    /* Modal styles */
    .modal {
      transition: opacity 0.3s ease;
      z-index: 100;
    }
    
    .modal.hidden {
      opacity: 0;
      pointer-events: none;
    }
    
    /* WhatsApp modal on top */
    #whatsapp-confirm-modal {
      z-index: 200;
    }
    
    /* Animation for smooth appearance */
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    
    .animate-fadeIn {
      animation: fadeIn 0.3s ease-out;
    }
    
    /* Custom focus styles for accessibility */
    .using-keyboard *:focus {
      outline: 2px solid #F4C85B;
      outline-offset: 2px;
    }
    
    /* Hover effects */
    .hover-lift {
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    
    .hover-lift:hover {
      transform: translateY(-2px);
    }
    
    /* Touch-friendly buttons */
    .btn-touch {
      min-height: 44px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    
    /* Image fit */
    .img-fit {
      object-fit: cover;
      width: 100%;
      height: 100%;
    }
    
    /* Hide scrollbar but keep functionality */
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    
    /* Mobile optimizations */
    @media (max-width: 768px) {
      .container-padding {
        padding-left: 1rem;
        padding-right: 1rem;
      }
    }
  </style>
</head>

<body class="bg-white text-gray-900 overflow-x-hidden" data-is-logged-in="<%= user ? 'true' : 'false' %>">
  <!-- Preloader -->
  <div id="preloader">
    <img src="/famslogo.png" alt="<%= SITE_NAME %> logo" class="h-16 md:h-20 w-auto preloader-logo" />
  </div>

  <!-- WhatsApp Confirmation Modal -->
  <div id="whatsapp-confirm-modal" class="modal hidden fixed inset-0 bg-black bg-opacity-70 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-sm w-full p-6 animate-fadeIn shadow-2xl mx-4">
      <div class="text-center mb-6">
        <div class="w-14 h-14 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
          <i class="fab fa-whatsapp text-green-600 text-xl"></i>
        </div>
        <h3 class="text-lg font-bold text-gray-900 mb-2">Continue to WhatsApp?</h3>
        <p class="text-gray-600 text-sm" id="whatsapp-modal-text">You'll be redirected to WhatsApp to chat with us.</p>
      </div>
      <div class="flex flex-col gap-2">
        <button id="confirm-whatsapp" class="w-full bg-green-600 hover:bg-green-700 text-white font-semibold py-3 px-4 rounded-lg transition-colors btn-touch text-sm">
          <i class="fab fa-whatsapp mr-2"></i>
          Open WhatsApp
        </button>
        <button id="cancel-whatsapp" class="w-full border border-gray-300 hover:bg-gray-50 text-gray-700 font-semibold py-3 px-4 rounded-lg transition-colors btn-touch text-sm">
          Cancel
        </button>
      </div>
    </div>
  </div>

  <!-- Product Detail Modal -->
  <div id="product-modal" class="modal hidden fixed inset-0 bg-black bg-opacity-70 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-4xl w-full max-h-[85vh] overflow-y-auto animate-fadeIn mx-4">
      <div id="product-modal-content" class="p-4 md:p-6">
        <!-- Content loaded via JavaScript -->
      </div>
    </div>
  </div>

  <!-- Header -->
  <header class="fixed top-0 w-full bg-white shadow-sm z-40 border-b">
    <div class="max-w-7xl mx-auto px-4 py-3 flex justify-between items-center">
      <div class="flex items-center gap-2">
        <img src="/famslogo.png" alt="<%= SITE_NAME %> logo" class="h-8 md:h-10 w-auto" />
        <span class="text-base md:text-lg font-bold text-gray-900">Fam's Fashion</span>
      </div>

      <nav class="hidden md:flex gap-6 text-sm font-medium">
        <a href="#hero" class="text-gray-800 hover:text-[#F4C85B] transition-colors duration-200">Home</a>
        <% if (user) { %>
          <a href="/buy" class="text-gray-800 hover:text-[#F4C85B] transition-colors duration-200">All Products</a>
        <% } %>
        <a href="#about" class="text-gray-800 hover:text-[#F4C85B] transition-colors duration-200">About</a>
        <a href="#contact" class="text-gray-800 hover:text-[#F4C85B] transition-colors duration-200">Contact</a>
      </nav>

      <div class="flex items-center gap-2">
        <% if (user) { %>
          <a href="/dashboard" class="hidden md:flex items-center gap-2 px-3 py-2 rounded-lg hover:bg-gray-50 transition-colors">
            <div class="w-8 h-8 bg-amber-100 text-amber-600 rounded-full flex items-center justify-center text-xs font-bold uppercase">
              <%= user.full_name.charAt(0) %>
            </div>
            <span class="text-sm font-medium text-gray-700">My Account</span>
          </a>
        <% } else { %>
          <a href="/login" class="px-3 py-2 text-sm font-bold text-gray-700 hover:text-[#F4C85B] transition-colors">Login</a>
          <a href="/register" class="px-4 py-2 text-sm font-bold bg-gray-900 text-white rounded-lg hover:bg-gray-800 transition-all">Register</a>
        <% } %>

        <button onclick="openWhatsAppModal('<%= WHATSAPP_CHAT_URL %>', 'chat')" 
           class="hidden sm:flex items-center px-3 py-2 rounded-lg bg-[#F4C85B] hover:bg-amber-500 text-black font-medium transition-colors duration-200 btn-touch text-sm">
          <i class="fab fa-whatsapp mr-1"></i>
          <span class="hidden md:inline">Chat</span>
        </button>
        
        <!-- Mobile menu button -->
        <button id="mobile-menu-button" class="md:hidden text-gray-800 p-2 rounded-lg hover:bg-gray-100 btn-touch" aria-label="Toggle mobile menu">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>
    
    <!-- Mobile Menu -->
    <div id="mobile-menu" class="md:hidden hidden bg-white px-4 pb-4 shadow-lg border-t">
      <div class="flex flex-col space-y-3">
        <a href="#about" class="text-gray-800 hover:text-[#F4C85B] transition-colors py-3 border-b border-gray-100 text-sm">About</a>
        <a href="#contact" class="text-gray-800 hover:text-[#F4C85B] transition-colors py-3 border-b border-gray-100 text-sm">Contact</a>
        
        <% if (user) { %>
          <a href="/dashboard" class="text-gray-800 hover:text-[#F4C85B] transition-colors py-3 border-b border-gray-100 text-sm font-bold">My Account</a>
          <a href="/logout" class="text-red-500 py-3 border-b border-gray-100 text-sm font-bold">Logout</a>
        <% } else { %>
          <a href="/login" class="text-gray-800 hover:text-[#F4C85B] transition-colors py-3 border-b border-gray-100 text-sm font-bold">Login</a>
          <a href="/register" class="text-gray-800 hover:text-[#F4C85B] transition-colors py-3 border-b border-gray-100 text-sm font-bold">Register</a>
        <% } %>

        <button onclick="openWhatsAppModal('<%= WHATSAPP_CHAT_URL %>', 'chat')" 
           class="flex items-center justify-center px-4 py-3 rounded-lg bg-[#F4C85B] hover:bg-amber-500 text-black font-medium transition-colors btn-touch text-sm">
          <i class="fab fa-whatsapp mr-2"></i>
          Chat on WhatsApp
        </button>
      </div>
    </div>
  </header>

  <!-- Hero Section -->
  <section id="hero" class="pt-24 pb-12 md:pt-28 md:pb-16 bg-gradient-to-br from-amber-50 to-amber-100">
    <div class="max-w-6xl mx-auto px-4 text-center">
      <img src="/famslogo.png" alt="<%= SITE_NAME %> logo" class="mx-auto h-16 md:h-20 mb-4" />
      <h1 class="text-2xl md:text-4xl lg:text-5xl font-bold mb-4 text-gray-900 leading-tight">
        Elegant Fashion, <span class="text-[#F4C85B]">Perfect Finish</span>
      </h1>
      <p class="text-gray-700 max-w-2xl mx-auto mb-6 text-sm md:text-base leading-relaxed">
        Discover premium dresses, kaftans and classy outfits tailored to perfection. Experience luxury fashion with exceptional craftsmanship.
      </p>

      <div class="flex flex-col sm:flex-row gap-2 justify-center max-w-md mx-auto">
        <% if (user) { %>
        <a href="/buy" class="px-5 py-3 bg-[#F4C85B] hover:bg-amber-500 text-black rounded-lg font-semibold transition-colors flex items-center justify-center btn-touch text-sm">
          <i class="fas fa-tshirt mr-2"></i>
          View All Products
        </a>
        <% } %>
        <button onclick="openWhatsAppModal('<%= WHATSAPP_CHAT_URL %>', 'chat')" class="px-5 py-3 bg-gray-800 hover:bg-gray-900 text-white rounded-lg font-semibold transition-colors flex items-center justify-center btn-touch text-sm">
          <i class="fab fa-whatsapp mr-2"></i>
          Chat with Us
        </button>
      </div>
    </div>
  </section>


  <!-- Featured Products -->
  <section id="products" class="py-12 md:py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-xl md:text-3xl font-bold mb-2 text-gray-900">Featured Collection</h2>
        <p class="text-gray-600 max-w-2xl mx-auto text-xs md:text-sm">Handpicked selection of our most exquisite fashion pieces</p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <% if (featuredProducts && featuredProducts.length > 0) { %>
          <% featuredProducts.forEach(product => { %>
          <div class="bg-white rounded-xl shadow-sm hover:shadow-md transition-all duration-200 overflow-hidden hover-lift border">
            <div class="relative overflow-hidden aspect-[3/4] group">
              <img src="/<%= product.image_path %>" 
                   alt="<%= product.name %>"
                   class="img-fit group-hover:scale-105 transition-transform duration-300"
                   onerror="this.src='https://via.placeholder.com/300x400/f3f4f6/9ca3af?text=Product+Image'">
              <div class="absolute top-2 right-2 flex flex-col gap-2">
                <div class="bg-[#F4C85B] text-black px-2 py-1 rounded-full text-xs font-bold shadow-sm">
                  ₦<%= product.price.toLocaleString() %>
                </div>
                <button data-id="<%= product.id %>" 
                        class="fav-btn bg-white text-gray-400 hover:text-red-500 w-8 h-8 rounded-full flex items-center justify-center shadow-md transition-all active:scale-90">
                  <i class="fas fa-heart"></i>
                </button>
              </div>
            </div>
            <div class="p-3">
              <h3 class="font-semibold text-gray-900 mb-1 text-sm leading-tight"><%= product.name %></h3>
              <p class="text-gray-600 text-xs mb-3 line-clamp-2"><%= product.description %></p>
              <div class="flex flex-col gap-2">
                <div class="flex gap-1">
                    <button data-id="<%= product.id %>" 
                            class="btn-view-product flex-1 px-2 py-2 bg-gray-100 hover:bg-gray-200 text-gray-800 rounded-lg font-medium transition-colors flex items-center justify-center btn-touch text-xs">
                    <i class="fas fa-eye mr-1"></i>
                    View
                    </button>
                    <button data-url="<%= WHATSAPP_CHAT_URL %>?text=Hi! I'm interested in <%= encodeURIComponent(product.name) %> (₦<%= product.price.toLocaleString() %>)" 
                            data-type="product"
                            class="btn-buy-product flex-1 px-2 py-2 bg-gray-800 hover:bg-gray-900 text-white rounded-lg font-medium transition-colors flex items-center justify-center btn-touch text-xs">
                    <i class="fab fa-whatsapp mr-1"></i>
                    Chat
                    </button>
                </div>
                <button data-id="<%= product.id %>" 
                        class="btn-add-to-cart w-full px-2 py-2 bg-[#F4C85B] hover:bg-amber-500 text-black rounded-lg font-bold transition-colors flex items-center justify-center btn-touch text-xs">
                  <i class="fas fa-shopping-cart mr-2"></i>
                  Add to Cart
                </button>
              </div>
            </div>
          </div>
          <% }); %>
        <% } else { %>
          <div class="col-span-4 text-center py-8">
            <i class="fas fa-tshirt text-3xl text-gray-300 mb-3"></i>
            <p class="text-gray-500 text-sm">No featured products available.</p>
          </div>
        <% } %>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section id="about" class="py-12 md:py-16 bg-gradient-to-br from-amber-50 to-amber-100">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-xl md:text-3xl font-bold mb-4 text-gray-900">Crafting Fashion Excellence</h2>
      <p class="text-gray-600 text-sm md:text-base mb-6 leading-relaxed">
        At <%= SITE_NAME %>, we blend traditional craftsmanship with contemporary design 
        to create pieces that celebrate individuality and elegance. Each garment is meticulously 
        tailored to ensure perfect fit and exceptional comfort.
      </p>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4 max-w-2xl mx-auto">
        <div class="bg-white rounded-lg p-4 shadow-sm">
          <i class="fas fa-gem text-[#F4C85B] text-lg mb-2"></i>
          <p class="font-medium text-gray-900 text-sm">Premium Quality</p>
        </div>
        <div class="bg-white rounded-lg p-4 shadow-sm">
          <i class="fas fa-ruler-combined text-[#F4C85B] text-lg mb-2"></i>
          <p class="font-medium text-gray-900 text-sm">Perfect Fit</p>
        </div>
        <div class="bg-white rounded-lg p-4 shadow-sm">
          <i class="fas fa-shipping-fast text-[#F4C85B] text-lg mb-2"></i>
          <p class="font-medium text-gray-900 text-sm">Fast Delivery</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="py-12 md:py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-xl md:text-3xl font-bold mb-4 text-gray-900">Get In Touch</h2>
      <p class="text-gray-600 text-sm md:text-base mb-6">
        Ready to elevate your style? Contact us for custom orders and styling advice.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center max-w-md mx-auto">
        <button onclick="openWhatsAppModal('<%= WHATSAPP_CHAT_URL %>', 'chat')" 
                class="px-5 py-3 bg-[#F4C85B] hover:bg-amber-500 text-black rounded-lg font-semibold transition-colors flex items-center justify-center btn-touch text-sm">
          <i class="fab fa-whatsapp mr-2"></i>
          WhatsApp Us
        </button>
        <a href="tel:+<%= WHATSAPP_NUMBER %>"
           class="px-5 py-3 border-2 border-gray-800 hover:bg-gray-800 hover:text-white text-gray-800 rounded-lg font-semibold transition-colors flex items-center justify-center btn-touch text-sm">
          <i class="fas fa-phone mr-2"></i>
          Call Now
        </a>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-gray-900 text-gray-300 py-8">
    <div class="max-w-6xl mx-auto px-4 text-center">
      <div class="mb-4">
        <h3 class="text-white font-bold text-lg mb-2"><%= SITE_NAME %></h3>
        <p class="text-sm text-gray-400">Premium Fashion Gallery</p>
      </div>
      <p class="text-xs mb-4">
        WhatsApp: <a href="#" onclick="openWhatsAppModal('<%= WHATSAPP_CHAT_URL %>', 'chat')" class="text-[#F4C85B] underline">+<%= WHATSAPP_NUMBER %></a>
      </p>
      <p class="text-xs">
        <a href="https://buildlect.com" target="_blank" rel="noopener" class="text-[#F4C85B] underline">Powered by Buildlect Technologies</a>
      </p>
    </div>
  </footer>

  <!-- Admin Access -->
  <a href="/admin" class="fixed bottom-4 right-4 z-30 bg-[#F4C85B] hover:bg-amber-500 text-black p-3 rounded-full shadow-lg hover-lift transition-all duration-200 opacity-40 hover:opacity-100 btn-touch">
    <i class="fas fa-cog text-sm"></i>
  </a>

  <script>
    const IS_LOGGED_IN = document.body.dataset.isLoggedIn === 'true';
    
    // Enhanced preloader with 1.5-second duration
    function hidePreloader() {
      const preloader = document.getElementById('preloader');
      if (preloader) {
        preloader.classList.add('fade-out');
        setTimeout(() => {
          preloader.style.display = 'none';
        }, 500);
      }
    }

    // Hide preloader when page loads (1.5 seconds)
    window.addEventListener('load', function() {
      setTimeout(hidePreloader, 1500);
    });

    // Fallback: hide preloader after 3 seconds
    setTimeout(hidePreloader, 3000);

    // Mobile menu functionality
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    
    if (mobileMenuButton && mobileMenu) {
      mobileMenuButton.addEventListener('click', function() {
        mobileMenu.classList.toggle('hidden');
      });
    }

    // Modal functionality
    const productModal = document.getElementById('product-modal');
    const whatsappModal = document.getElementById('whatsapp-confirm-modal');
    let currentWhatsAppUrl = '';

    function openProductModal(productId) {
      fetch(`/get-product?id=${productId}`)
        .then(response => {
          if (!response.ok) throw new Error('Network error');
          return response.text();
        })
        .then(html => {
          if (productModal) {
            document.getElementById('product-modal-content').innerHTML = html;
            productModal.classList.remove('hidden');
          }
        })
        .catch(error => {
          console.error('Error:', error);
          openWhatsAppModal('<%= WHATSAPP_CHAT_URL %>?text=Hi! I\'m interested in product ID ' + productId, 'product');
        });
    }

    function closeProductModal() {
      if (productModal) {
        productModal.classList.add('hidden');
      }
    }

    function openWhatsAppModal(url, type = 'chat') {
      currentWhatsAppUrl = url;
      const modalText = document.getElementById('whatsapp-modal-text');
      
      if (modalText) {
        if (type === 'product') {
          modalText.textContent = 'You\'ll be redirected to WhatsApp to inquire about this product.';
        } else {
          modalText.textContent = 'You\'ll be redirected to WhatsApp to chat with us.';
        }
      }
      
      if (whatsappModal) {
        whatsappModal.classList.remove('hidden');
      }
    }

    function closeWhatsAppModal() {
      if (whatsappModal) {
        whatsappModal.classList.add('hidden');
      }
    }

    function confirmWhatsApp() {
      if (currentWhatsAppUrl) {
        window.open(currentWhatsAppUrl, '_blank');
      }
      closeWhatsAppModal();
    }

    // Event listeners
    document.addEventListener('DOMContentLoaded', function() {
      // WhatsApp modal events
      const confirmWhatsAppBtn = document.getElementById('confirm-whatsapp');
      const cancelWhatsAppBtn = document.getElementById('cancel-whatsapp');
      
      if (confirmWhatsAppBtn) confirmWhatsAppBtn.addEventListener('click', confirmWhatsApp);
      if (cancelWhatsAppBtn) cancelWhatsAppBtn.addEventListener('click', closeWhatsAppModal);
    });

    // Close modals when clicking outside
    document.addEventListener('click', function(e) {
      if (productModal && e.target === productModal) closeProductModal();
      if (whatsappModal && e.target === whatsappModal) closeWhatsAppModal();
    });

    // Close modal with Escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        if (productModal && !productModal.classList.contains('hidden')) closeProductModal();
        if (whatsappModal && !whatsappModal.classList.contains('hidden')) closeWhatsAppModal();
      }
    });

    // Smooth scrolling for navigation links
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
          const headerHeight = document.querySelector('header').offsetHeight;
          const targetPosition = target.offsetTop - headerHeight;
          window.scrollTo({
            top: targetPosition,
            behavior: 'smooth'
          });
          
          // Close mobile menu if open
          if (mobileMenu) {
            mobileMenu.classList.add('hidden');
          }
        }
      });
    });

    // Add focus styles for accessibility
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Tab') {
        document.body.classList.add('using-keyboard');
      }
    });
    
    document.addEventListener('mousedown', function() {
      document.body.classList.remove('using-keyboard');
    });

    // Add to cart
    async function addToCart(productId) {
      if (!IS_LOGGED_IN) {
        window.location.href = '/login';
        return;
      }
      try {
        const response = await fetch('/api/cart/add', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ product_id: productId })
        });
        const result = await response.json();
        if (result.success) {
          alert('Item added to cart!');
          // Optional: update a cart counter in the UI
        }
      } catch (error) {
        console.error('Cart error:', error);
      }
    }

    async function toggleFavorite(productId, btn) {
      if (!IS_LOGGED_IN) {
        window.location.href = '/login?message=' + encodeURIComponent('Login to save favorites!');
        return;
      }
      
      const icon = btn.querySelector('i');
      try {
        const response = await fetch('/api/favorites/toggle', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ product_id: productId })
        });
        const result = await response.json();
        if (result.success) {
          if (result.action === 'added') {
            icon.classList.remove('far');
            icon.classList.add('fas', 'text-red-500');
            btn.classList.add('text-red-500');
          } else {
            icon.classList.remove('fas', 'text-red-500');
            icon.classList.add('fas');
            btn.classList.remove('text-red-500');
            btn.classList.add('text-gray-400');
          }
        }
      } catch (error) {
        console.error('Error:', error);
      }
    }

    // Add listener for favorite buttons and product modals
    document.addEventListener('click', function(e) {
      const favBtn = e.target.closest('.fav-btn');
      if (favBtn) {
        toggleFavorite(favBtn.dataset.id, favBtn);
      }

      const viewBtn = e.target.closest('.btn-view-product');
      if (viewBtn) {
        openProductModal(viewBtn.dataset.id);
      }

      const buyBtn = e.target.closest('.btn-buy-product');
      if (buyBtn) {
        openWhatsAppModal(buyBtn.dataset.url, buyBtn.dataset.type);
      }

      const addToCartBtn = e.target.closest('.btn-add-to-cart');
      if (addToCartBtn) {
        addToCart(addToCartBtn.dataset.id);
      }
    });
  </script>
</body>
</html>
