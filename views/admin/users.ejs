<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Users - Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-50">
    <div class="min-h-screen flex">
        <!-- Sidebar (Reuse logic from dashboard) -->
        <div class="w-64 bg-gray-900 text-white p-6 hidden md:block">
            <h2 class="text-xl font-bold mb-8">FFGallery Admin</h2>
            <nav class="space-y-2">
                <a href="/admin" class="flex items-center gap-3 p-3 rounded-lg hover:bg-gray-800 transition-colors">
                    <i class="fas fa-box"></i> Products
                </a>
                <a href="/admin/users" class="flex items-center gap-3 p-3 rounded-lg bg-[#F4C85B] text-black font-bold">
                    <i class="fas fa-users"></i> Users
                </a>
                <a href="/admin/orders" class="flex items-center gap-3 p-3 rounded-lg hover:bg-gray-800 transition-colors">
                    <i class="fas fa-shopping-cart"></i> Orders
                </a>
                <div class="pt-8">
                    <a href="/admin/logout" class="text-red-400 p-3 hover:text-red-300">Logout</a>
                </div>
            </nav>
        </div>

        <div class="flex-1 p-4 md:p-8">
            <header class="flex justify-between items-center mb-8">
                <h1 class="text-2xl font-bold">User Management</h1>
                <button onclick="document.getElementById('add-user-modal').classList.remove('hidden')" class="bg-gray-900 text-white px-4 py-2 rounded-lg font-bold">
                    <i class="fas fa-plus mr-2"></i> Add User
                </button>
            </header>

            <% if (message) { %>
                <div class="bg-white p-4 rounded-xl shadow-sm border-l-4 border-[#F4C85B] mb-6 animate-fadeIn">
                    <%= message %>
                </div>
            <% } %>

            <div class="bg-white rounded-2xl shadow-sm border overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left">
                        <thead class="bg-gray-50 border-b">
                            <tr>
                                <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase">Full Name</th>
                                <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase">Email</th>
                                <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase">Phone</th>
                                <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase">Joined</th>
                                <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y">
                            <% users.forEach(user => { %>
                                <tr class="hover:bg-gray-50">
                                    <td class="px-6 py-4 font-medium"><%= user.full_name %></td>
                                    <td class="px-6 py-4 text-gray-600"><%= user.email %></td>
                                    <td class="px-6 py-4 text-gray-600"><%= user.phone %></td>
                                    <td class="px-6 py-4 text-xs text-gray-400"><%= new Date(user.created_at).toLocaleDateString() %></td>
                                    <td class="px-6 py-4">
                                        <form action="/admin/delete-user" method="POST" onsubmit="return confirm('Delete this user?')">
                                            <input type="hidden" name="user_id" value="<%= user.id %>">
                                            <button class="text-red-400 hover:text-red-600">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Add User Modal -->
    <div id="add-user-modal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-md w-full p-6">
            <h3 class="text-xl font-bold mb-6">Create New User</h3>
            <form action="/admin/create-user" method="POST" class="space-y-4">
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Full Name</label>
                    <input type="text" name="full_name" required class="w-full px-4 py-3 rounded-lg border">
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Email</label>
                    <input type="email" name="email" required class="w-full px-4 py-3 rounded-lg border">
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Password</label>
                    <input type="password" name="password" required class="w-full px-4 py-3 rounded-lg border">
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Phone</label>
                    <input type="tel" name="phone" class="w-full px-4 py-3 rounded-lg border">
                </div>
                <div class="flex gap-2 pt-4">
                    <button type="button" onclick="document.getElementById('add-user-modal').classList.add('hidden')" class="flex-1 py-3 border rounded-lg font-bold">Cancel</button>
                    <button type="submit" class="flex-1 py-3 bg-gray-900 text-white rounded-lg font-bold">Create User</button>
                </div>
            </form>
        </div>
    </div>
</body>
</html>
