<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome to <%= SITE_NAME %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap');
        body { font-family: 'Outfit', sans-serif; }
        .bg-glass { background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(10px); }
    </style>
</head>
<body class="bg-gray-950 text-white overflow-hidden">
    <!-- Background Design -->
    <div class="fixed inset-0 z-0">
        <div class="absolute top-[-10%] left-[-10%] w-[50%] h-[50%] bg-amber-500/20 rounded-full blur-[120px]"></div>
        <div class="absolute bottom-[-10%] right-[-10%] w-[50%] h-[50%] bg-amber-600/10 rounded-full blur-[120px]"></div>
    </div>

    <main class="relative z-10 h-screen flex flex-col items-center justify-center px-4 text-center">
        <div class="mb-8 animate-bounce">
            <img src="/famslogo.png" alt="<%= SITE_NAME %> logo" class="h-24 w-auto mx-auto" />
        </div>
        
        <h1 class="text-4xl md:text-6xl font-bold mb-4 tracking-tight">
            Elevate Your <span class="text-amber-500">Style</span>
        </h1>
        <p class="text-gray-400 max-w-lg mx-auto mb-10 text-lg leading-relaxed">
            Welcome to Fam's Fashion Gallery. Our exclusive collection is reserved for our members. 
            Join us to explore premium dresses, kaftans, and bespoke outfits.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 w-full max-w-md">
            <a href="/login" class="flex-1 bg-amber-500 hover:bg-amber-600 text-black font-bold py-4 px-8 rounded-2xl transition-all transform hover:scale-105 shadow-xl shadow-amber-500/20">
                Log In
            </a>
            <a href="/register" class="flex-1 bg-white/10 hover:bg-white/20 text-white font-bold py-4 px-8 rounded-2xl transition-all border border-white/10">
                Create Account
            </a>
        </div>

        <div class="mt-16 pt-8 border-t border-white/5 w-full max-w-xs text-xs text-gray-500 uppercase tracking-widest">
            Premium Fashion Gallery
        </div>
    </main>

    <!-- Footer for Visitors -->
    <footer class="fixed bottom-8 w-full text-center z-10 text-gray-600 text-[10px] uppercase tracking-widest">
        Powered by Buildlect Technologies &copy; <%= new Date().getFullYear() %>
    </footer>
</body>
</html>
